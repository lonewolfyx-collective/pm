    "find-up": "^8.0.0",
    "fzf": "^0.5.2",
    "giget": "^3.3.1",
    "glob": "^13.0.6",
    "ofetch": "^1.5.1",
    "package-manager-detector": "^1.8.0",
    "pkg-types": "^2.3.3",
    "replace-in-file": "^9.0.0",
    "rimraf": "^6.1.3",
    "tinyexec": "^1.3.1",
    "yaml": "^2.9.1"
  },
