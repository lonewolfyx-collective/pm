    "@antfu/eslint-config": "^9.5.1",
    "@lonewolfyx/create": "^0.0.13",
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@lonewolfyx/vitepress-theme": "workspace:*",
    "@schemastore/pnpm-workspace": "^1.0.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "verify-git-commit": "^0.0.1",
    "vitepress": "^2.0.0-alpha.20"
