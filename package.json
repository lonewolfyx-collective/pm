    "./dev": "./dist/dev.mjs",
    "./init": "./dist/init.mjs",
    "./ni": "./dist/ni.mjs",
    "./remove": "./dist/remove.mjs",
    "./run": "./dist/run.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "catalog": "./bin/catalog.mjs",
    "ni": "./bin/ni.mjs",
    "remove": "./bin/remove.mjs",
